# PickFromPic Environment Variables
# Copy this file to .env and fill in values as needed

# App URL (for sitemap, canonical links)
VITE_APP_URL=https://pickfrompic.com

# Screenshot service API key (optional, falls back to thum.io free tier)
VITE_SCREENSHOT_API_KEY=

# Unsplash access key (optional, for search feature)
VITE_UNSPLASH_ACCESS_KEY=
